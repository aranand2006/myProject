      var response = JSON.parse(this.responseText);
      handleWholesalerSpecificLogicForLoyaltyWidget(response);
    }
  };
}

function generateOrderNumber(wholesaleCode, countryCode) {
  var dateTimeInMillis = new Date();
  var orderNumber =
    wholesaleCode +
    "_" +
    countryCode +
    Math.floor(
      dateTimeInMillis.toISOString().replace(/-|:|T|Z|/g, "") *
        Math.random() *
        1000,
    );
  return orderNumber;
}

var widgetClosedCount = localStorage.getItem("widgetClosedCount");
if (widgetClosedCount == null) {
  widgetClosedCount = 0;
}

var hideWidgetOnClosedCount = properties.hideWidgetOnClosedCount;
var numberOfDaysToHideWidgetOnClosed =
  properties.numberOfDaysToHideWidgetOnClosed;

var numberOfDaysToClearLocalStorage =
  properties.numberOfDaysToClearLocalStorage;

// ================================== loyalty points common method calls ==========================================

function extractSingleItemLoyaltyPoints(product, loyaltyPointsData) {
  for (let i = 0; i < loyaltyPointsData.length; i++) {
    if (loyaltyPointsData[i].wsProductCode === product) {
      return loyaltyPointsData[i].singleItemLoyaltyPoints;
    }
  }
  return 0;
}

function extractSingleItemLoyaltyPointsForQuantity(productCode, quantity) {
  const loyaltyPointsData = JSON.parse(
    localStorage.getItem("loyaltyPointsData"),
  );
  if (loyaltyPointsData != null && loyaltyPointsData != undefined) {
    for (let i = 0; i < loyaltyPointsData.length; i++) {
      if (loyaltyPointsData[i].wsProductCode === productCode) {
        return loyaltyPointsData[i].singleItemLoyaltyPoints * quantity;
      }
    }
  }
  return 0;
}

function extractCartonItemLoyaltyPoints(product, loyaltyPointsData) {
  for (let i = 0; i < loyaltyPointsData.length; i++) {
    if (loyaltyPointsData[i].wsProductCode === product) {
      return loyaltyPointsData[i].cartonItemLoyaltyPoints;
    }
  }
  return 0;
}

function extractCartonItemLoyaltyPointsForQuantity(productCode, quantity) {
  const loyaltyPointsData = JSON.parse(
    localStorage.getItem("loyaltyPointsData"),
  );
  if (loyaltyPointsData != null && loyaltyPointsData != undefined) {
    for (let i = 0; i < loyaltyPointsData.length; i++) {
      if (loyaltyPointsData[i].wsProductCode === productCode) {
        return loyaltyPointsData[i].cartonItemLoyaltyPoints * quantity;
      }
    }
  }
  return 0;
}

function extractData(order_data, order_number) {
  document.getElementById("div").style["display"] = "none";
  order_data.forEach(function (ele) {
    ele.orderNumber = order_number;
  });
  localStorage.removeItem("data");
  localStorage.setItem("data", JSON.stringify(order_data));
}

function getLoyaltyPoint(productId, response) {
  const lpData = JSON.parse(localStorage.getItem("loyaltyPointsData"));
  for (let i = 0; i < lpData.length; i++) {
    if (lpData[i].wsProductCode === productId) {
      return lpData[i].singleItemLoyaltyPoints;
    }
  }
  return 0;
}

function getLoyaltyPointsTextTag(loyaltyPointsTextPattern, loyaltypoints) {
  return (
    '<span class="mytext">' +
    getLoyaltyPointsText(loyaltyPointsTextPattern, loyaltypoints) +
    "</span>"
  );
}

function getLoyaltyPointsText(loyaltyPointsTextPattern, loyaltypoints) {
  return loyaltyPointsTextPattern.replace("{0}", loyaltypoints);
}

