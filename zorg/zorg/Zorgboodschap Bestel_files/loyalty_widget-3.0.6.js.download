// ================================== Order api call ==========================================
function callOrderApi(
  countryCode,
  language,
  wholesalerCode,
  orderNumber,
  customerId,
  handleWholesalerCodeSpecificLogic,
) {
  let order_data = JSON.parse(localStorage.getItem("data"));
  if (order_data.length > 0) {
    let orderData = prepareOrderData(
      countryCode,
      language,
      wholesalerCode,
      orderNumber,
      order_data,
    );

    let duplicatedOrder = false; //  setting a flag to avoid the duplication data entry
    if (localStorage.getItem("duplicateOrderNumber") === null) {
      localStorage.setItem("duplicateOrderNumber", orderData.orderId);
      duplicatedOrder = localStorage.getItem("duplicateOrderNumber");
    } else {
      let currentOrderNumber = localStorage.getItem("duplicateOrderNumber");
      if (orderData.orderId != currentOrderNumber) {
        localStorage.setItem("duplicateOrderNumber", orderData.orderId);
        duplicatedOrder = true;
      }
    }

    if (duplicatedOrder != "undefined" || duplicatedOrder.length > 1) {
      let xmlHttpRequest = new XMLHttpRequest(); // new HttpRequest instance
      let theUrl = properties.f1BaseApi + "/order";
      xmlHttpRequest.open("POST", theUrl);
      xmlHttpRequest.setRequestHeader("Content-Type", "application/json");
      xmlHttpRequest.setRequestHeader("Access-Control-Allow-Origin", "true");
      console.log(JSON.stringify(orderData));
      xmlHttpRequest.send(JSON.stringify(orderData));
      xmlHttpRequest.onreadystatechange = function () {
        if (this.readyState == 4 && this.status == 202) {
          handleWholesalerCodeSpecificLogic(orderData);
        }
      };
    }
  }
}
// ================================== Order Data Pereparation ==============================
function prepareOrderData(
  countryCode,
  language,
  wholesalerCode,
  orderNumber,
  orderData,
) {
  let orderDataRequest = {};
  let products = [];
  orderDataRequest.countryCode =
    countryCode != null ? countryCode : orderData[0].countryCode;
  orderDataRequest.languageCode =
    language != null ? language : orderData[0].language;
  orderDataRequest.orderId =
    orderNumber != null ? orderNumber : orderData[0].orderNumber;
  orderDataRequest.email = localStorage.getItem("email");
  orderDataRequest.wholesalerCode =
    wholesalerCode != null ? wholesalerCode : orderData[0].wholesalerCode;
  orderData.forEach((element) => {
    let productDto = {};
    productDto.productName = element.productName;
    productDto.quantity = element.quantity;
    productDto.productCode = element.productCode;
    productDto.productUnit = element.productUnit;
    products.push(productDto);
  });
  orderDataRequest.products = products;
  return orderDataRequest;
}

// ================================== Customer Loyalty Points api call ==========================================

function callcustomerLoyaltyPointsApi(orderData) {
  lpInvokeCount++;
  console.log(lpInvokeCount + " Loading Loyalty Points");
  let customerId = "";
  if (localStorage.getItem("customerId") != null) {
    customerId = localStorage.getItem("customerId");
  }
  let orderNumber = orderData.orderId;
  let email = localStorage.getItem("email");
  var xmlhttp = new XMLHttpRequest();
  var theUrl =
    properties.f1BaseApi +
    "/loyalty-points/customer?customerId=" +
    customerId +
    "&email=" +
    email +
    "&orderId=" +
    orderNumber;
  xmlhttp.open("GET", theUrl);
  xmlhttp.send();
  xmlhttp.onreadystatechange = function () {
    if (this.readyState === 4 && this.status === 200) {
      var response = JSON.parse(this.responseText);
      let lp = getTotalLoyaltyPoint(orderData);
      if (response.currentOrderLoyaltyPoint === lp) {
        showTotalAndCurrentOrderLoyaltyPoint(orderData.languageCode, response);
        lpInvokeCount = 0;
      } else if (lpInvokeCount <= 5) {
        invokeLoyaltyPointsApiRepeatedly(orderData);
      } else {
        lpInvokeCount = 0;
        document.querySelector(".total_loyalty_points").textContent =
          "Failed to load earned loyalty points. Please check your email.";
      }
    }
  };
}

function callcustomerLoyaltyPointsApiBe(orderData) {
  switch (language) {
    case "fr":
      widgetText = widgetTexts.be_fr;
      break;
    case "en":
      widgetText = widgetTexts.be_en;
      break;
    default:
      widgetText = widgetTexts.be_nl;
  }
  lpInvokeCount++;
  console.log(lpInvokeCount + " Loading Loyalty Points");
  let customerId = "";
  if (localStorage.getItem("customerId") != null) {
    customerId = localStorage.getItem("customerId");
  }
  let orderNumber = orderData.orderId;
  let email = localStorage.getItem("email");
  var xmlhttp = new XMLHttpRequest();
  var theUrl =
    properties.f1BaseApi +
    "/loyalty-points/customer?customerId=" +
    customerId +
    "&email=" +
    email +
    "&orderId=" +
    orderNumber;

  const HTTP_TIMEOUT = apiConfig.HTTP_TIMEOUT;
  const URL =
    properties.f1BaseApi +
    "/loyalty-points/customer?customerId=" +
    customerId +
    "&email=" +
    email +
    "&orderId=" +
    orderNumber;
  let scriptPath = properties.scriptPath;
  scriptPath = scriptPath.split("/");
  let url = scriptPath[0] + "//" + scriptPath[2];
  (async () => {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), HTTP_TIMEOUT);

    try {
      const response = await fetch(URL, {
        signal: controller.signal,
      }).then((res) => res.json());
      console.log(response);
      const element = document.getElementById("lp-loader");
      element.classList.add("hide-cls");
      const ele = document.getElementById("loading-block");
      ele.classList.remove("hide-cls");

      var elem = document.getElementById("file");
      elem.style.width = cssConfig.maxWidth + "%";
      elem.setAttribute("max", cssConfig.maxWidth);
      var width = 1;
      let setflag = false;
      var id = setInterval(frame, apiConfig.minInterval);
      function frame() {
        if (width >= cssConfig.maxWidth) {
          setflag = true;
          clearInterval(id);
          if (setflag == true) {
            let lp = getTotalLoyaltyPoint(orderData);
            if (response.currentOrderLoyaltyPoint === lp) {
              showTotalAndCurrentOrderLoyaltyPointBe(
                orderData.languageCode,
                response,
              );
              lpInvokeCount = apiConfig.MinInvokeCount;
            } else if (lpInvokeCount <= apiConfig.MaxInvokeCount) {
              invokeLoyaltyPointsApiRepeatedly(orderData);
            } else {
              lpInvokeCount = apiConfig.MinInvokeCount;
              document.getElementById("expand-final").innerHTML =
                `  <div class="widget-text-cls">
          <img class="success" src="${url}/images/alert.svg" alt="success">
          <p class="success-points">${widgetText.failedText}</p>
        </div>
        <div class="widget-form-cls">
          <div class="success-block-cls">
            <p class="redeem-block-cls" id="unimsg">
              Please
              <a href="#" title="unileverfoodsolutions">check your mailbox</a>
              to review your points
            </p>
          </div>
        </div>
        <div class="widget-footer-cls"></div>`;
              document.getElementById("unimsg").innerHTML = widgetText.loyalRes;
            }
          }
        } else {
          setflag = false;
          width++;
          elem.setAttribute("value", width);
        }
      }
    } catch (error) {
      console.error(error);
      document.getElementById("expand-final").innerHTML =
        `  <div class="widget-text-cls">
          <img class="success" src="${url}/images/alert.svg" alt="success">
          <p class="success-points">${widgetText.failedText}</p>
        </div>
        <div class="widget-form-cls">
          <div class="success-block-cls">
            <p class="redeem-block-cls" id="unimsg">
              Please
              <a href="#" title="unileverfoodsolutions">check your mailbox</a>
              to review your points
            </p>
          </div>
        </div>
        <div class="widget-footer-cls"></div>`;
      document.getElementById("unimsg").innerHTML = widgetText.loyalRes;
    } finally {
      clearTimeout(timeoutId);
    }
  })();
}

// ================================== Loyalty Points api call ==========================================

function callLoyaltyPointsApi(productIds, wsCode, page) {
  if (productIds.length > 0) {
    const showProductsLp = properties.showProductsLP;
    var xmlhttp = new XMLHttpRequest();
    var theUrl =
      properties.f1BaseApi + "/loyalty-points/product?wholesalerCode=" + wsCode;
    xmlhttp.open("POST", theUrl);
    xmlhttp.setRequestHeader("Content-Type", "application/json");
    xmlhttp.send(JSON.stringify(productIds));
    xmlhttp.onreadystatechange = function () {
      if (this.readyState === 4 && this.status === 200) {
        var response = JSON.parse(this.responseText);
        localStorage.setItem("loyaltyPointsData", JSON.stringify(response));
        console.log(response);
        if (showProductsLp == true) {
          if (page == "cart") {
            loyaltyPointsResponseUiForCartPage();
          } else if (page !== "Warenkorb") {
            loyaltyPointsResponseUi(response);
          }
        }
      }
    };
  }
}

