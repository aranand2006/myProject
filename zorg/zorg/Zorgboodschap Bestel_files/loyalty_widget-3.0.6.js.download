            to redeem your loyalty program points
          </p>
        </div>      
	 `,
  );
  document.getElementById("unimsg").innerHTML = widgetText.loyalRes;
}

function observeUrlAndHideWidget(hiddenWidgetEndpoints, id) {
  const observer = new MutationObserver(function (mutations) {
    let exists = hiddenWidgetEndpoints.some((endpoint) =>
      location.href.includes(endpoint),
    );
    if (exists) {
      hideElementWithId(id);
    }
  });
  const config = { subtree: true, childList: true };
  observer.observe(document, config);
}

function hideElementWithId(id) {
  document.getElementById(id).style.display = "none";
}

function closeWidget() {
  document.getElementById("div").style["display"] = "none";
  localStorage.setItem("removed", true);
  localStorage.setItem("widgetClosedDate", new Date());
  widgetClosedCount = parseInt(widgetClosedCount) + 1;
  localStorage.setItem("widgetClosedCount", widgetClosedCount);
}

function hideWidgetOnClosed() {
  var dateToday = new Date();
  var hideWidgetOnClosedExpDate = new Date(
    localStorage.getItem("widgetClosedDate"),
  );

  hideWidgetOnClosedExpDate.setDate(
    hideWidgetOnClosedExpDate.getDate() +
      parseInt(numberOfDaysToHideWidgetOnClosed),
  );

  if (
    widgetClosedCount >= hideWidgetOnClosedCount &&
    dateToday <= hideWidgetOnClosedExpDate
  ) {
    return true;
  } else {
    return false;
  }
}

if (checkLocalStorageExpiry()) {
  clearLocalStorage();
}

function checkLocalStorageExpiry() {
  if (localStorage.getItem("registeredDate") != null) {
    var dateToday = new Date();
    var localStorageExpDate = new Date(localStorage.getItem("registeredDate"));
    localStorageExpDate.setDate(
      localStorageExpDate.getDate() + parseInt(numberOfDaysToClearLocalStorage),
    );
    if (dateToday >= localStorageExpDate) {
      return true;
    } else {
      return false;
    }
  }
}

function clearLocalStorage() {
  localStorage.removeItem("data");
  localStorage.removeItem("show_widget");
  localStorage.removeItem("cartData");
  localStorage.removeItem("productData");
  localStorage.removeItem("email");
  localStorage.removeItem("business_name");
  localStorage.removeItem("enrolled");
  localStorage.removeItem("isOrderSubmitted");
  localStorage.removeItem("cart-products-count");
  localStorage.removeItem("isOrderSuccess");
  localStorage.removeItem("removed");
  localStorage.removeItem("isWidget");
  localStorage.removeItem("orderSuccess");
  localStorage.removeItem("orderNumber");
  localStorage.removeItem("cartSize");
  localStorage.removeItem("customerId");
  localStorage.removeItem("customerIdXpath");
  localStorage.removeItem("local_count");
  localStorage.removeItem("start_date");
  localStorage.removeItem("registeredDate");
}

function enableStartSavingButton(mandatoryWidgetElementIds) {
  let enable = false;
  let countChecked = 0;
  for (let i = 0; i < mandatoryWidgetElementIds.length; i++) {
    if (
      document.getElementById(mandatoryWidgetElementIds[i]).type ==
        "checkbox" &&
      document.getElementById(mandatoryWidgetElementIds[i]).checked
    ) {
      countChecked++;
    }
  }

  if (countChecked == mandatoryWidgetElementIds.length) {
    document.getElementById("startsaving").disabled = false;
    document.getElementById("startsaving").style.opacity = "1.0";
  } else {
    document.getElementById("startsaving").disabled = true;
    document.getElementById("startsaving").style.opacity = "0.5";
  }
}

// Method to assign product unit type. If Karton the DU else CU.
function assignProductUnitType(productDetails) {
  if (productDetails === "Karton" || productDetails.includes("Karton")) {
    return "DU";
  }
  return "CU";
}

localStorage.setItem("orderListenerAdded", false);

function observeOrderButton() {
  const observer = new MutationObserver(function (mutations) {
    showWidgetAndProductLP();
    orderButtonElement = getElementByXpath(orderButtonXpath);
    if (
      orderButtonElement != null &&
      typeof orderButtonElement != "undefined" &&
      localStorage.getItem("orderListenerAdded") == "false"
    ) {
      orderButtonElement.addEventListener("click", function (e) {
        initiateOrderProcess();
      });
      localStorage.setItem("orderListenerAdded", true);
    } else if (
      orderButtonElement == null ||
      typeof orderButtonElement == "undefined"
    ) {
      localStorage.setItem("orderListenerAdded", false);
    }
  });
  const config = { subtree: true, childList: true };
  observer.observe(document, config);
}

function getElementByXpath(path) {
  let xValue = null;
  try {
    xValue = document.evaluate(
      path,
      document,
      null,
      XPathResult.FIRST_ORDERED_NODE_TYPE,
      null,
    ).singleNodeValue;
  } catch (ex) {
    console.error("Provided XPath expression is not valid.");
  }
  return xValue;
}

function initiateOrderProcess() {
  collecCartData();
  collectLoyaltyPoints();
  detectOrder();
}

function getElementContentByXpath(path) {
  let xValue = null;
  try {
    xValue = document.evaluate(
      path,
      document,
      null,
      XPathResult.FIRST_ORDERED_NODE_TYPE,
      null,
    ).singleNodeValue.content;
  } catch (ex) {
    console.error("Provided XPath expression is not valid.");
  }
  return xValue;
}

function getElementTextContentByXpath(path) {
  let xValue = null;
  try {
    xValue = document.evaluate(
      path,
      document,
      null,
      XPathResult.FIRST_ORDERED_NODE_TYPE,
      null,
    ).singleNodeValue.textContent;
  } catch (ex) {
    console.error("Provided XPath expression is not valid.");
  }
  return xValue;
}

function getValidCustomerId(custId) {
  let specialChars = /[`!@#$%^&*()_\-+=\[\]{};':"\\|,.<>\/?~ ]/;
  let hasSpecialCharacters = specialChars.test(custId);
  if (hasSpecialCharacters == true || custId == "null") {
    return "";
  }
  return custId;
}

function prepareRegistrationDataJSON(
  countryCode,
  email,
  businessName,
  languageCode,
  wholesalerCode,
  newsletterSubscription,
  customerId,
) {
  var registrationDateJSON = {};
  registrationDateJSON.countryCode = countryCode;
  registrationDateJSON.email = email;
  registrationDateJSON.businessName = businessName;
  registrationDateJSON.languageCode = languageCode;
  registrationDateJSON.wholesalerCode = wholesalerCode;
  registrationDateJSON.isNewsletterSubscribed = newsletterSubscription;
  if (
    customerId !== null ||
    typeof customerId !== "undefined" ||
    !customerId.length === 0
  ) {
    registrationDateJSON.customerId = customerId;
  }
  return registrationDateJSON;
}
if (typeof module !== "undefined" && module.exports) {
module.exports = {
      extractSingleItemLoyaltyPoints,
      extractSingleItemLoyaltyPointsForQuantity,
      extractCartonItemLoyaltyPoints,
      extractCartonItemLoyaltyPointsForQuantity,
      extractData,
      getLoyaltyPoint,
      getLoyaltyPointsTextTag,
      getLoyaltyPointsText,
      showTotalAndCurrentOrderLoyaltyPoint,
      assignProductUnitType,
  };
}

