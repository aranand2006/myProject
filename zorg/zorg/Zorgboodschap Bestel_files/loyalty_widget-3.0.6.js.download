function extractLoyaltyPointsBasedOnProductUnit(productCode, productUnit){
   let lpData = JSON.parse(localStorage.getItem("loyaltyPointsData"));

   for (let i = 0; i < lpData.length; i++) {
       if(lpData[i].wsProductCode === productCode){
        if(productUnit==="CU"){
            return lpData[i].singleItemLoyaltyPoints;
        }
        return lpData[i].cartonItemLoyaltyPoints;
       }
   }
}


