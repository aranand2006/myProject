        '<th> <div id="finalImageLogo" style="width:100px;height:35px; margin-bottom: 10px"> <img src="" class="final_image" style="width:100%;height:100%;max-width:none;margin:5px;border-radius:5px;"></div></th>' +
        '<th style="font-size:12px;text-align:left; padding: 0;margin: 0" id="uni">Thanks for using our loyalty programme</th></tr></tbody></table></div>' +
        '<h5 class="total_loyalty_points">Loading earned loyalty points ...</h5>' +
        '<div class="expand_response" style="margin-top:1%; font-size: 12px;text-align:justify">' +
        '<p id="unimsg" style="margin: auto">Thank you for using our loyalty program! To view the points you have earned visit ' +
        '<a href="https://www.unileverfoodsolutions.ch/de.html" target="_blank" style= "color:#ff5501">ufs.com' +
        "</a> and login or enroll using your email</p></div></div>",
    );

  var h = document.getElementsByTagName("head").item(0);
  var s = document.createElement("style");
  s.type = "text/css";
  s.appendChild(
    document.createTextNode("#minimize{-webkit-transform:rotate(0deg);}"),
  );
  s.appendChild(
    document.createTextNode("#maximize{-webkit-transform:rotate(90deg);}"),
  );
  s.appendChild(
    document.createTextNode("#minimize1{-webkit-transform:rotate(-90deg);}"),
  );
  s.appendChild(
    document.createTextNode("#maximize1{-webkit-transform:rotate(90deg);}"),
  );
  h.appendChild(s);

  if (properties.hideCookSaveLogo) {
    document.getElementById("cookSaveLogo").remove();
  }
  setOrderResponseUITextByCountryAndLangauge(countryCode, languageCode);
}

