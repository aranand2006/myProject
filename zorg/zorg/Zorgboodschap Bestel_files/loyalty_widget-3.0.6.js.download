          "   " +
          txt3 +
          " " +
          response.totalLoyaltyPoint +
          "   " +
          '<i class="fa-solid fa-hand-holding-dollar fa-flip-horizontal"></i>' +
          "</p>",
      );
  } else {
    document.getElementsByClassName("total_loyalty_points")[0].style[
      "display"
    ] = "none";
  }
}

