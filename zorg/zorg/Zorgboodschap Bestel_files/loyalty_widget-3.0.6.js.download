function registerUser(userId, business_name) {
  let subscription = document.getElementById("check_box1").checked;
  localStorage.removeItem("email");
  localStorage.setItem("email", userId);
  localStorage.setItem("business_name", business_name);
  callRegisterUserApi(
    prepareRegistrationDataJSON(
      countryCode,
      userId,
      business_name,
      language,
      wholesalerCode,
      subscription,
      localStorage.getItem("customerId"),
    ),
    function () {
      var response = this.responseText;
      localStorage.setItem("enrolled", true);
      localStorage.setItem("registeredDate", new Date());
      minimizeWidget();
    },
  );
}
function callRegisterUserApi(
  register_data,
  handleWholesalerSpecificLogicForRegistration,
) {
  var xmhttp = new XMLHttpRequest();
  var theUrl = properties.f1BaseApi + "/user/register";
  xmhttp.open("POST", theUrl);
  xmhttp.setRequestHeader("Content-Type", "application/json");
  xmhttp.setRequestHeader("Access-Control-Allow-Origin", "true");
  xmhttp.send(JSON.stringify(register_data));
  xmhttp.onreadystatechange = function () {
    if (this.readyState === 4 && this.status === 202) {
      console.log("User Registration Request has been accepted");
      handleWholesalerSpecificLogicForRegistration();
    }
  };
}

