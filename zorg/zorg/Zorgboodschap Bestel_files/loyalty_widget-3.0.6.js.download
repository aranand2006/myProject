function collectCartProductCodes(){
    let productCodes = [];
    let lineItemDetailContainers = document.querySelectorAll(".line-item-details-container");
    lineItemDetailContainers.forEach(function(lineItemDetail){
        let productCode = lineItemDetail.querySelector("a").getAttribute("href").split("/")[4];
        productCode = productCode.split("?")[0];
        productCodes.push(productCode);
    });
    return productCodes;
}


