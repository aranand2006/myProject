function saveCartProductInLocalStorage(){
  let data = [];
  let lineItemProducts = document.querySelectorAll(".line-item-product");
  lineItemProducts.forEach(function(wholesalerProduct){
    let productCode = wholesalerProduct
    .querySelector(".line-item-details-container")
    .querySelector("a")
    .getAttribute("href")
    .split("/")[4]
    .split("?")[0];

    let productName = wholesalerProduct
    .querySelector(".line-item-details-container")
    .querySelector("a")
    .getAttribute("title");

    let productUnit = wholesalerProduct
    .querySelector(".line-item-details-container")
    .querySelector(".line-item-packaging-value")
    .innerText.split(" ")[0];

    if(productUnit === "DS"){
      productUnit = "DU";
    }else{
      productUnit = "CU";
    }

    let quantity = wholesalerProduct
    .querySelector(".line-item-quantity")
    .querySelector(".line-item-quantity__input-placeholder")
    .innerText;

    let productObj = {
      "productCode":productCode, 
      "productName":productName, 
      "quantity":quantity, 
      "productUnit":productUnit
    };
    data.push(productObj);
  
  });

  localStorage.setItem("data",data);
}

