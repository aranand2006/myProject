  div1.style.boxShadow = "0px 0px 2px 2px #d9d9d9";
  div1.style.backgroundColor = "white";
  div1.style.padding = "10px";
  div1.style.zIndex = "99";
  div1.style.display = "none";
  document.body.appendChild(div1);

  // =======================================================================================================================================================================

  var orderResponseWidget = document
    .getElementById("final_div")
    .insertAdjacentHTML(
      "beforeend",
      '<strong id="orderResponseWidgetCancel" style="margin-top: -11px;cursor:pointer;color:gray;float:right;font-size: 20px;" onclick="closeResponse()">&times;</strong>' +
        '<span id="orderResponseWidgetMinimize"style="cursor:pointer;color:gray;float:right;margin-top:-10px;margin-right:12px;transform:rotate(-90deg);font-size:15px"onclick="minimizeResponse()">&#10094;</span>' +
        '<span id="orderResponseWidgetMaximize"style="display:none;cursor:pointer;color:gray;float:right;margin-top:-10px;margin-right:12px;transform:rotate(90deg);font-size:15px"onclick="maximizeResponse()">&#10094;</span>' +
        '<div id="uni_item" style="display:none"><div><table style="width:100%"><tbody><tr>' +
