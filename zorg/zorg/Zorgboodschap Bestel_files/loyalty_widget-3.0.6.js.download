function callLoyaltyWidgetApi(
  wholesalerCode,
  language,
  handleWholesalerSpecificLogicForLoyaltyWidget,
) {
  var xmlhttp = new XMLHttpRequest();
  var theUrl =
    properties.f1BaseApi +
