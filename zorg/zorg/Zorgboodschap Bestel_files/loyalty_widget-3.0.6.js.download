function setOrderResponseUITextByCountryAndLangauge(countryCode, languageCode) {
  languageCode = languageCode.split("-")[0];
  if (countryCode === "MY") {
    switch (languageCode) {
      case "en":
        document.getElementById("uni").innerHTML = widgetTexts.my_en.loyalHead;
        document.getElementById("unimsg").innerHTML =
          widgetTexts.my_en.loyalRes;
        break;
    }
  }
  if (countryCode === "CH") {
    switch (languageCode) {
      case "de":
        document.getElementById("uni").innerHTML = widgetTexts.ch_de.loyalHead;
        document.getElementById("unimsg").innerHTML =
          widgetTexts.ch_de.loyalRes;
        break;
    }
  }
  if (countryCode === "BE") {
    switch (languageCode) {
      case "en": {
        document.getElementById("uni").innerHTML = widgetTexts.be_en.loyalHead;
        document.getElementById("unimsg").innerHTML =
          widgetTexts.be_en.loyalRes;
        document.getElementById("loading-text").innerHTML =
          widgetTexts.be_en.loadingLpText;
        break;
      }
      case "fr": {
        document.getElementById("uni").innerHTML = widgetTexts.be_fr.loyalHead;
        document.getElementById("unimsg").innerHTML =
          widgetTexts.be_fr.loyalRes;
        document.getElementById("loading-text").innerHTML =
          widgetTexts.be_fr.loadingLpText;
        break;
      }
      default: {
        document.getElementById("uni").innerHTML = widgetTexts.be_nl.loyalHead;
        document.getElementById("unimsg").innerHTML =
          widgetTexts.be_nl.loyalRes;
        document.getElementById("loading-text").innerHTML =
          widgetTexts.be_nl.loadingLpText;
        break;
      }
    }
  }
  if (countryCode === "DE") {
    switch (languageCode) {
      case "de":
        document.getElementById("uni").innerHTML = widgetTexts.de_de.loyalHead;
        document.getElementById("unimsg").innerHTML =
          widgetTexts.de_de.loyalRes;
    }
  }
}

/**
 * This method will minimize the loyalty widget response widget.
 */
function minimizeResponse() {
  [].forEach.call(document.querySelectorAll(".expand_response"), function (el) {
    el.style["display"] = "none";
  });
  document.getElementById("orderResponseWidgetMinimize").style["display"] =
    "none";
  document.getElementById("orderResponseWidgetMaximize").style["display"] =
    "block";
  document.querySelector(".total_loyalty_points").style["display"] = "none";
}

/**
 * This method will maximize the loyalty widget response widget.
 */
function maximizeResponse() {
  [].forEach.call(document.querySelectorAll(".expand_response"), function (el) {
    el.style["display"] = "block";
  });
  document.getElementById("orderResponseWidgetMinimize").style["display"] =
    "block";
  document.getElementById("orderResponseWidgetMaximize").style["display"] =
    "none";
  document.querySelector(".total_loyalty_points").style["display"] = "block";
}

function closeResponse() {
  document.getElementById("final_div").style["display"] = "none";
}

